---
import "../styles/site.css";
interface Props {
	title: string;
	description?: string;
	wide?: boolean;
	/** A private page — a board, the create form: out of search, whatever a header layer does. */
	noindex?: boolean;
}
const { title, description, wide = false, noindex = false } = Astro.props;
const boards = import.meta.env.PUBLIC_BOARDS_ENABLED === "true";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="referrer" content="no-referrer" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="icon" href="/favicon.svg" />
		<link rel="mcp" href="/.well-known/mcp-server-card" type="application/json" />
	</head>
	<body>
		<header class:list={["site-header", { wide }]}>
			<nav class="site-nav">
				<a class="site-wordmark" href="/">darsay</a>
				<a href="/docs/getting-started/">Docs</a>
				{boards && <a href="/boards">Boards</a>}
				<a href="https://github.com/darsay-io/darsay" rel="noreferrer">GitHub</a>
			</nav>
		</header>
		<slot />
		<footer class:list={["site-foot", { wide }]}>
			<nav aria-label="darsay.io">
				<a href="/docs/">Documentation</a>
				<a href="/agents/">Agents &amp; API</a>
				<a href="/privacy/">Privacy</a>
				<a href="/terms/">Terms</a>
				<a href="https://github.com/darsay-io/darsay" rel="noreferrer">GitHub</a>
			</nav>
		</footer>
	</body>
</html>
